#!/usr/bin/env python3
"""Stable reaperctl dispatcher that preserves the verified core and adds continuation commands."""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CORE_PATH = ROOT / "bin" / "reaperctl-core"
RENDER_PATH = ROOT / "scripts" / "reaper-render.py"


def _load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_core = _load("reaperctl_core", CORE_PATH)

# Preserve the proven public Python surface for existing tests and integrations.
for _name, _value in vars(_core).items():
    if not _name.startswith("__"):
        globals().setdefault(_name, _value)


def _split_global_baseline(argv: list[str]) -> tuple[list[str], str | None]:
    remaining: list[str] = []
    baseline: str | None = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--baseline":
            if i + 1 >= len(argv):
                return argv, None
            baseline = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--baseline="):
            baseline = arg.split("=", 1)[1]
            i += 1
            continue
        remaining.append(arg)
        i += 1
    return remaining, baseline


def main() -> int:
    stripped, baseline = _split_global_baseline(sys.argv[1:])
    if stripped and stripped[0] == "render":
        render = _load("reaperctl_render", RENDER_PATH)
        render_args = stripped[1:]
        if baseline is not None:
            render_args = ["--baseline", baseline, *render_args]
        return int(render.main(render_args))
    return int(_core.main())


if __name__ == "__main__":
    raise SystemExit(main())
