#!/usr/bin/env python3
"""Deterministic control-plane CLI for the Reaper Golden Master continuation."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_BASELINE = REPO_ROOT / "BASELINE.json"

EXPECTED_GM_ID = "sha256:74a13a11fe232bca5bd8a320d11ee0c2e17ce5c2e53d76c74ee9714276a95b1f"
EXPECTED_PROOF_HEAD = "6b76608974737e0b59818db94ecbc21018615794"
EXPECTED_PAYLOAD_BYTES = 888_467_386
EXPECTED_LOCKS = {
    "linux_audio_mode": 1,
    "interface": "apollo_spdif",
    "spdif_input_channels": 2,
    "spdif_output_channels": 2,
    "sample_rate_hz": 48000,
    "buffer_samples": 256,
    "buffer_count": 3,
    "project": "ASIO-Routing-Project",
    "tempo_bpm": 120,
    "time_signature": "4/4",
}


@dataclass(frozen=True)
class Check:
    name: str
    ok: bool
    detail: str


def load_baseline(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise ValueError(f"baseline file not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise ValueError(f"invalid baseline JSON: {exc}") from exc
    if not isinstance(data, dict):
        raise ValueError("baseline root must be a JSON object")
    return data


def static_checks(data: dict[str, Any]) -> list[Check]:
    baseline = data.get("baseline") if isinstance(data.get("baseline"), dict) else {}
    locks = data.get("continuity_locks") if isinstance(data.get("continuity_locks"), dict) else {}
    policy = data.get("policy") if isinstance(data.get("policy"), dict) else {}

    checks = [
        Check("schema_version", data.get("schema_version") == 1, f"value={data.get('schema_version')!r}"),
        Check(
            "golden_master_id",
            baseline.get("golden_master_id") == EXPECTED_GM_ID,
            f"value={baseline.get('golden_master_id')!r}",
        ),
        Check(
            "payload_bytes",
            baseline.get("payload_bytes") == EXPECTED_PAYLOAD_BYTES,
            f"value={baseline.get('payload_bytes')!r}",
        ),
        Check(
            "recovery_authority_proof_head",
            baseline.get("recovery_authority_proof_head") == EXPECTED_PROOF_HEAD,
            f"value={baseline.get('recovery_authority_proof_head')!r}",
        ),
    ]

    bad_locks = {
        key: {"actual": locks.get(key), "expected": value}
        for key, value in EXPECTED_LOCKS.items()
        if locks.get(key) != value
    }
    checks.append(
        Check(
            "continuity_locks",
            not bad_locks,
            "all canonical locks match" if not bad_locks else json.dumps(bad_locks, sort_keys=True),
        )
    )

    policy_ok = (
        policy.get("baseline_is_immutable") is True
        and policy.get("silent_regression_allowed") is False
        and policy.get("runtime_change_requires_new_candidate") is True
        and policy.get("golden_master_promotion_requires_explicit_verification") is True
    )
    checks.append(Check("continuation_policy", policy_ok, "immutable baseline / explicit promotion required"))
    return checks


def _path_check(name: str, path: Path, kind: str) -> Check:
    if kind == "file":
        ok = path.is_file()
    else:
        ok = path.is_dir()
    return Check(name, ok, str(path))


def live_checks(data: dict[str, Any]) -> list[Check]:
    locks = data["continuity_locks"]
    workspace = Path(os.environ.get("REAPER_GM_WORKSPACE_ROOT", "/mnt/data/ubuntu-desktop-workspace"))
    apollo = Path(os.environ.get("REAPER_GM_VIRTUAL_APOLLO_ROOT", "/mnt/data/virtual-apollo"))
    project = Path(
        os.environ.get(
            "REAPER_GM_PROJECT",
            str(workspace / "projects" / "ASIO-Routing-Project" / "ASIO-Routing-Project.RPP"),
        )
    )
    reaper = Path(os.environ.get("REAPER_GM_REAPER_BINARY", str(workspace / "apps" / "REAPER" / "reaper")))
    apollo_status = Path(os.environ.get("REAPER_GM_APOLLO_STATUS", str(apollo / "status-apollo.sh")))
    display = os.environ.get("REAPER_GM_DISPLAY", str(locks.get("display", ":88")))

    checks = [
        _path_check("workspace_root", workspace, "dir"),
        _path_check("virtual_apollo_root", apollo, "dir"),
        _path_check("canonical_project", project, "file"),
        _path_check("reaper_binary", reaper, "file"),
        _path_check("apollo_status_script", apollo_status, "file"),
    ]

    xdpyinfo = shutil.which("xdpyinfo")
    if xdpyinfo is None:
        checks.append(Check("x11_display", False, f"xdpyinfo unavailable; expected display {display}"))
    else:
        try:
            result = subprocess.run(
                [xdpyinfo, "-display", display],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3,
                check=False,
            )
            checks.append(Check("x11_display", result.returncode == 0, f"display={display}"))
        except (OSError, subprocess.TimeoutExpired) as exc:
            checks.append(Check("x11_display", False, f"display={display}; {exc}"))

    pgrep = shutil.which("pgrep")
    if pgrep is None:
        checks.append(Check("reaper_process", False, "pgrep unavailable"))
    else:
        result = subprocess.run(
            [pgrep, "-f", str(reaper)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        checks.append(Check("reaper_process", result.returncode == 0, str(reaper)))

    return checks


def render_checks(checks: list[Check], as_json: bool, scope: str) -> int:
    ok = all(check.ok for check in checks)
    if as_json:
        print(json.dumps({"scope": scope, "ok": ok, "checks": [asdict(check) for check in checks]}, indent=2))
    else:
        print(f"reaperctl health [{scope}]")
        for check in checks:
            marker = "PASS" if check.ok else "FAIL"
            print(f"{marker:4}  {check.name}: {check.detail}")
        print("PASS" if ok else "FAIL")
    return 0 if ok else 1


def cmd_baseline(args: argparse.Namespace, data: dict[str, Any]) -> int:
    checks = static_checks(data)
    if not all(check.ok for check in checks):
        return render_checks(checks, args.json, "baseline")
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        baseline = data["baseline"]
        locks = data["continuity_locks"]
        print(f"Golden Master: {baseline['golden_master']}")
        print(f"Golden Master ID: {baseline['golden_master_id']}")
        print(f"Recovery authority proof head: {baseline['recovery_authority_proof_head']}")
        print(
            "Audio lock: "
            f"{locks['interface']} / {locks['sample_rate_hz']} Hz / "
            f"{locks['buffer_samples']} samples x {locks['buffer_count']} / "
            f"{locks['spdif_input_channels']} in / {locks['spdif_output_channels']} out"
        )
    return 0


def cmd_health(args: argparse.Namespace, data: dict[str, Any]) -> int:
    checks = static_checks(data)
    scope = "static"
    if not args.static:
        checks.extend(live_checks(data))
        scope = "live"
    return render_checks(checks, args.json, scope)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="reaperctl", description=__doc__)
    parser.add_argument(
        "--baseline",
        type=Path,
        default=Path(os.environ.get("REAPERCTL_BASELINE", DEFAULT_BASELINE)),
        help="Path to BASELINE.json (default: repository BASELINE.json)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    baseline = sub.add_parser("baseline", help="Show and validate the admitted Golden Master baseline")
    baseline.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    health = sub.add_parser("health", help="Validate baseline continuity and optionally the live REAPER workspace")
    health.add_argument("--static", action="store_true", help="Check repository/baseline state only")
    health.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        data = load_baseline(args.baseline)
    except ValueError as exc:
        print(f"reaperctl: {exc}", file=sys.stderr)
        return 2

    if args.command == "baseline":
        return cmd_baseline(args, data)
    if args.command == "health":
        return cmd_health(args, data)
    parser.error(f"unsupported command: {args.command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
