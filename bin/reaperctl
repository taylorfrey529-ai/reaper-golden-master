#!/usr/bin/env python3
"""Stable reaperctl dispatcher that preserves the verified core and adds continuation commands."""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CORE_PATH = ROOT / "bin" / "reaperctl-core"
RENDER_PATH = ROOT / "scripts" / "reaper-render.py"
STEMS_PATH = ROOT / "scripts" / "reaper-export-stems.py"
ALIGN_PATH = ROOT / "scripts" / "reaper-align-drums.py"
PAN_DRUMS_PATH = ROOT / "scripts" / "reaper-pan-drums.py"
SCREENSHOT_PATH = ROOT / "scripts" / "reaper-screenshot.py"
SNAPSHOT_PATH = ROOT / "scripts" / "reaper-snapshot.py"
BACKUP_PATH = ROOT / "scripts" / "reaper-backup.py"
RESTORE_PATH = ROOT / "scripts" / "reaper-restore.py"


def _load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_core = _load("reaperctl_core", CORE_PATH)

for _name, _value in vars(_core).items():
    if not _name.startswith("__"):
        globals().setdefault(_name, _value)


def _split_global_baseline(argv: list[str]) -> tuple[list[str], str | None]:
    remaining: list[str] = []
    baseline: str | None = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--baseline":
            if i + 1 >= len(argv):
                return argv, None
            baseline = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--baseline="):
            baseline = arg.split("=", 1)[1]
            i += 1
            continue
        remaining.append(arg)
        i += 1
    return remaining, baseline


def main() -> int:
    stripped, baseline = _split_global_baseline(sys.argv[1:])
    commands = {
        "render": RENDER_PATH,
        "export-stems": STEMS_PATH,
        "align-drums": ALIGN_PATH,
        "pan-drums": PAN_DRUMS_PATH,
        "screenshot": SCREENSHOT_PATH,
        "snapshot": SNAPSHOT_PATH,
        "backup": BACKUP_PATH,
        "restore": RESTORE_PATH,
    }
    if stripped and stripped[0] in commands:
        command = stripped[0]
        module = _load(f"reaperctl_{command.replace('-', '_')}", commands[command])
        command_args = stripped[1:]
        if baseline is not None and command not in {"backup", "restore"}:
            command_args = ["--baseline", baseline, *command_args]
        return int(module.main(command_args))
    return int(_core.main())


if __name__ == "__main__":
    raise SystemExit(main())
